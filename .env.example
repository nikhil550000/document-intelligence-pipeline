# Copy to .env. Docker Compose and the docintel command both read it.
# These values only work against the local services in docker-compose.yml.

POSTGRES_USER=docintel
POSTGRES_PASSWORD=docintel-local
POSTGRES_DB=docintel

DOCINTEL_DATABASE_URL=postgresql://docintel:docintel-local@localhost:5433/docintel

DOCINTEL_S3_ENDPOINT_URL=http://localhost:8333
DOCINTEL_S3_ACCESS_KEY_ID=docintel
DOCINTEL_S3_SECRET_ACCESS_KEY=docintel-local-secret
DOCINTEL_S3_BUCKET=docintel

# Only the commands that call a model need it. Never commit a real key.
FIREWORKS_API_KEY=
